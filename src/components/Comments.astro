---
const COMMENTS_API = import.meta.env.PUBLIC_COMMENTS_API ?? 'http://localhost:8787';
---

<section class="comments-section mt-12 border-t border-[var(--theme-divider)] pt-8">
	<h2 class="mb-6 text-xl font-semibold text-[var(--theme-text)]">Comentarios</h2>

	<div id="comments-list" class="mb-8 space-y-6">
		<p class="text-sm italic text-[var(--theme-text-lighter)]">Cargando comentarios...</p>
	</div>

	<!-- Reply form (floats to the clicked comment) -->
	<div id="reply-form-container" class="hidden">
		<div class="mt-3 flex gap-3">
			<div id="reply-avatar" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white select-none"></div>
			<div class="flex-1">
				<textarea
					id="reply-content"
					maxlength="2000"
					rows="3"
					class="w-full resize-y rounded-lg border border-[var(--theme-divider)] bg-[var(--theme-bg-offset)] px-3 py-2 text-sm text-[var(--theme-text)] placeholder:text-[var(--theme-text-lighter)] focus:outline-none focus:ring-2 focus:ring-[#2bbc8a]"
				></textarea>
				<div class="mt-1.5 flex items-center justify-between">
					<div class="flex gap-2">
						<button id="reply-submit" class="rounded-lg bg-[#2bbc8a] px-4 py-1.5 text-xs font-semibold text-white hover:opacity-80 disabled:opacity-50">
							Responder
						</button>
						<button id="reply-cancel" type="button" class="text-xs text-[var(--theme-text-lighter)] hover:text-[var(--theme-text)]">
							Cancelar
						</button>
					</div>
					<span id="reply-char-counter" class="text-xs text-[var(--theme-text-lighter)]">2000</span>
				</div>
				<p id="reply-error" class="mt-1 hidden text-xs text-red-500"></p>
			</div>
		</div>
	</div>

	<!-- New comment section -->
	<div class="border-t border-[var(--theme-divider)] pt-6">
		<div id="comments-ui">
			<!-- Auth panel -->
			<div id="auth-panel">
				<p class="mb-4 text-sm text-[var(--theme-text-lighter)]">
					Deja un comentario. Solo necesitas verificar tu email una vez.
				</p>
				<form id="auth-form" class="flex flex-col gap-3 sm:flex-row sm:items-end">
					<div class="flex flex-1 flex-col gap-1">
						<label for="input-name" class="text-xs font-medium text-[var(--theme-text)]">Nombre</label>
						<input
							id="input-name"
							type="text"
							name="name"
							placeholder="Tu nombre"
							required
							maxlength="60"
							class="rounded-lg border border-[var(--theme-divider)] bg-[var(--theme-bg-offset)] px-3 py-2 text-sm text-[var(--theme-text)] placeholder:text-[var(--theme-text-lighter)] focus:outline-none focus:ring-2 focus:ring-[#2bbc8a]"
						/>
					</div>
					<div class="flex flex-1 flex-col gap-1">
						<label for="input-email" class="text-xs font-medium text-[var(--theme-text)]">Email</label>
						<input
							id="input-email"
							type="email"
							name="email"
							placeholder="tu@email.com"
							required
							class="rounded-lg border border-[var(--theme-divider)] bg-[var(--theme-bg-offset)] px-3 py-2 text-sm text-[var(--theme-text)] placeholder:text-[var(--theme-text-lighter)] focus:outline-none focus:ring-2 focus:ring-[#2bbc8a]"
						/>
					</div>
					<button
						type="submit"
						class="shrink-0 rounded-lg bg-[#2bbc8a] px-5 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-80 disabled:opacity-50"
					>
						Enviar magic link
					</button>
				</form>
				<p id="auth-error" class="mt-2 hidden text-sm text-red-500"></p>
			</div>

			<!-- Awaiting verification -->
			<div id="awaiting-panel" class="hidden">
				<div class="rounded-xl border border-[#2bbc8a] bg-[var(--theme-bg-offset)] p-5">
					<p class="font-semibold text-[var(--theme-text)]">✉️ ¡Revisa tu email!</p>
					<p class="mt-1 text-sm text-[var(--theme-text-lighter)]">
						Te enviamos un enlace de verificación. Haz clic en él <strong>en este mismo browser</strong>.
					</p>
					<p class="mt-3 text-sm text-[var(--theme-text-lighter)]">
						¿El link abrió en otro browser? Cópialo y pégalo aquí, o
						<button id="retry-auth-btn" class="font-medium text-[#2bbc8a] underline-offset-2 hover:underline">solicita uno nuevo</button>.
					</p>
				</div>
			</div>

			<!-- Authenticated: new comment form -->
			<div id="comment-panel" class="hidden">
				<div class="flex gap-3">
					<div id="user-avatar" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white select-none"></div>
					<div class="flex-1">
						<form id="comment-form" class="flex flex-col gap-2">
							<textarea
								id="comment-content"
								placeholder="Añade un comentario... (Ctrl+Enter para enviar)"
								required
								maxlength="2000"
								rows="4"
								class="w-full resize-y rounded-lg border border-[var(--theme-divider)] bg-[var(--theme-bg-offset)] px-3 py-2 text-sm text-[var(--theme-text)] placeholder:text-[var(--theme-text-lighter)] focus:outline-none focus:ring-2 focus:ring-[#2bbc8a]"
							></textarea>
							<div class="flex items-center justify-between">
								<div class="flex gap-3">
									<button
										type="submit"
										class="rounded-lg bg-[#2bbc8a] px-5 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-80 disabled:opacity-50"
									>
										Comentar
									</button>
									<button
										type="button"
										id="logout-btn"
										class="text-xs text-[var(--theme-text-lighter)] underline-offset-2 hover:underline hover:text-[var(--theme-text)]"
									>
										Cerrar sesión
									</button>
								</div>
								<span id="char-counter" class="text-xs text-[var(--theme-text-lighter)]">2000</span>
							</div>
							<p id="comment-error" class="hidden text-sm text-red-500"></p>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script is:inline define:vars={{ COMMENTS_API }}>
	const API = COMMENTS_API;
	const JWT_KEY = 'blog_comments_jwt';
	const NAME_KEY = 'blog_comments_name';
	const MAX_CHARS = 2000;

	let activeReplyId = null;

	function getSlug() { return window.location.pathname.replace(/\/$/, '') || '/'; }
	function getJWT() { return localStorage.getItem(JWT_KEY); }
	function getName() { return localStorage.getItem(NAME_KEY) ?? ''; }
	function setSession(jwt, name) { localStorage.setItem(JWT_KEY, jwt); localStorage.setItem(NAME_KEY, name); }
	function clearSession() { localStorage.removeItem(JWT_KEY); localStorage.removeItem(NAME_KEY); }

	// ── Avatar ───────────────────────────────────────────────────────────────

	function avatarColor(name) {
		let hash = 0;
		for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
		return `hsl(${Math.abs(hash) % 360}, 55%, 45%)`;
	}

	// ── Relative time ────────────────────────────────────────────────────────

	function relativeDate(iso) {
		const diff = Date.now() - new Date(iso).getTime();
		const mins = Math.floor(diff / 60000);
		if (mins < 2) return 'hace un momento';
		if (mins < 60) return `hace ${mins} min`;
		const hours = Math.floor(mins / 60);
		if (hours < 24) return `hace ${hours}h`;
		const days = Math.floor(hours / 24);
		if (days < 30) return `hace ${days}d`;
		return new Date(iso).toLocaleDateString('es', { year: 'numeric', month: 'short', day: 'numeric' });
	}

	function escHtml(str) {
		return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	}

	// ── Build comment tree ───────────────────────────────────────────────────

	function buildTree(comments) {
		const map = new Map();
		const roots = [];
		for (const c of comments) map.set(c.id, { ...c, replies: [] });
		for (const c of comments) {
			if (c.parent_id && map.has(c.parent_id)) map.get(c.parent_id).replies.push(map.get(c.id));
			else roots.push(map.get(c.id));
		}
		return roots;
	}

	// ── Comment HTML ─────────────────────────────────────────────────────────

	function commentHtml(c, depth) {
		const isReply = depth > 0;
		const avatarSize = isReply ? 'h-7 w-7 text-xs' : 'h-9 w-9 text-sm';
		const initial = (c.author_name || '?')[0].toUpperCase();
		const color = avatarColor(c.author_name);
		const hasReplies = c.replies && c.replies.length > 0;

		const repliesHtml = `<div class="replies-container${hasReplies ? ' mt-4 space-y-4 border-l-2 border-[var(--theme-divider)] pl-4' : ''}" data-parent="${c.id}">
			${hasReplies ? c.replies.map(r => commentHtml(r, depth + 1)).join('') : ''}
		</div>`;

		return `<div class="comment" data-id="${c.id}">
			<div class="flex gap-3">
				<div style="background:${color}" class="${avatarSize} flex shrink-0 items-center justify-center rounded-full font-bold text-white select-none">
					${initial}
				</div>
				<div class="min-w-0 flex-1">
					<div class="mb-1 flex items-baseline gap-2">
						<span class="text-sm font-semibold text-[var(--theme-text)]">${escHtml(c.author_name)}</span>
						<span class="text-xs text-[var(--theme-text-lighter)]">${relativeDate(c.created_at)}</span>
					</div>
					<p class="text-sm leading-relaxed text-[var(--theme-text)] whitespace-pre-wrap">${escHtml(c.content)}</p>
					<button
						class="reply-trigger mt-1.5 text-xs text-[var(--theme-text-lighter)] transition-colors hover:text-[#2bbc8a]"
						data-comment-id="${c.id}"
						data-comment-author="${escHtml(c.author_name)}"
					>↩ Responder</button>
					${repliesHtml}
				</div>
			</div>
		</div>`;
	}

	// ── Render ───────────────────────────────────────────────────────────────

	function bindReplyTriggers(root) {
		root.querySelectorAll('.reply-trigger').forEach(btn =>
			btn.addEventListener('click', handleReplyClick)
		);
	}

	function renderComments(comments) {
		const list = document.getElementById('comments-list');
		if (!comments.length) {
			list.innerHTML = '<p class="text-sm italic text-[var(--theme-text-lighter)]">Sé el primero en comentar.</p>';
			return;
		}
		const tree = buildTree(comments);
		list.innerHTML = tree.map(c => commentHtml(c, 0)).join('');
		bindReplyTriggers(list);
	}

	function appendComment(comment) {
		const parentId = comment.parent_id || null;
		const commentNode = { ...comment, replies: [] };

		if (parentId) {
			const container = document.querySelector(`[data-parent="${parentId}"]`);
			if (container) {
				if (container.children.length === 0) {
					container.className = 'replies-container mt-4 space-y-4 border-l-2 border-[var(--theme-divider)] pl-4';
					container.setAttribute('data-parent', parentId);
				}
				const div = document.createElement('div');
				div.innerHTML = commentHtml(commentNode, 1);
				const node = div.firstElementChild;
				container.appendChild(node);
				bindReplyTriggers(node);
			}
		} else {
			const list = document.getElementById('comments-list');
			const placeholder = list.querySelector('p');
			if (placeholder) list.innerHTML = '';
			const div = document.createElement('div');
			div.innerHTML = commentHtml(commentNode, 0);
			const node = div.firstElementChild;
			list.appendChild(node);
			bindReplyTriggers(node);
		}
	}

	// ── Reply click ──────────────────────────────────────────────────────────

	function handleReplyClick(e) {
		const btn = e.currentTarget;
		const commentId = btn.dataset.commentId;
		const author = btn.dataset.commentAuthor;
		const container = document.getElementById('reply-form-container');

		if (!getJWT()) {
			document.getElementById('comments-ui').scrollIntoView({ behavior: 'smooth' });
			return;
		}

		if (activeReplyId === commentId) {
			container.classList.add('hidden');
			activeReplyId = null;
			return;
		}

		btn.insertAdjacentElement('afterend', container);
		container.classList.remove('hidden');
		document.getElementById('reply-content').placeholder = `Responde a @${author}... (Ctrl+Enter para enviar)`;
		document.getElementById('reply-content').value = '';
		document.getElementById('reply-char-counter').textContent = MAX_CHARS;
		document.getElementById('reply-char-counter').style.color = '';
		document.getElementById('reply-error').classList.add('hidden');

		const replyAvatar = document.getElementById('reply-avatar');
		const name = getName();
		replyAvatar.textContent = (name || '?')[0].toUpperCase();
		replyAvatar.style.background = avatarColor(name);

		activeReplyId = commentId;
		document.getElementById('reply-content').focus();
	}

	// ── Panels ───────────────────────────────────────────────────────────────

	function showPanel(id) {
		['auth-panel', 'awaiting-panel', 'comment-panel'].forEach(p =>
			document.getElementById(p).classList.toggle('hidden', p !== id)
		);
	}

	// ── Load ─────────────────────────────────────────────────────────────────

	async function loadComments() {
		try {
			const res = await fetch(`${API}/api/comments?slug=${encodeURIComponent(getSlug())}`);
			const data = await res.json();
			renderComments(Array.isArray(data) ? data : []);
		} catch {
			document.getElementById('comments-list').innerHTML =
				'<p class="text-sm text-red-500">No se pudieron cargar los comentarios.</p>';
		}
	}

	async function checkMagicToken() {
		const token = new URLSearchParams(window.location.search).get('comment_token');
		if (!token) return false;
		history.replaceState(null, '', window.location.pathname + window.location.hash);
		try {
			const res = await fetch(`${API}/api/auth/verify?token=${encodeURIComponent(token)}`);
			const data = await res.json();
			if (res.ok && data.jwt) { setSession(data.jwt, data.name); return true; }
		} catch {}
		return false;
	}

	async function init() {
		await loadComments();
		const verified = await checkMagicToken();
		if (verified || getJWT()) {
			showPanel('comment-panel');
			const name = getName();
			document.getElementById('user-avatar').textContent = (name || '?')[0].toUpperCase();
			document.getElementById('user-avatar').style.background = avatarColor(name);
		} else {
			showPanel('auth-panel');
		}
	}

	// ── Auth form ────────────────────────────────────────────────────────────

	document.getElementById('auth-form').addEventListener('submit', async (e) => {
		e.preventDefault();
		const name = document.getElementById('input-name').value.trim();
		const email = document.getElementById('input-email').value.trim();
		const btn = e.target.querySelector('button[type="submit"]');
		const errEl = document.getElementById('auth-error');
		btn.disabled = true; btn.textContent = 'Enviando...';
		errEl.classList.add('hidden');
		try {
			const res = await fetch(`${API}/api/auth/magic-link`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, name, returnUrl: window.location.href }),
			});
			const data = await res.json();
			if (res.ok) showPanel('awaiting-panel');
			else { errEl.textContent = data.error ?? 'Error al enviar el enlace.'; errEl.classList.remove('hidden'); }
		} catch {
			errEl.textContent = 'Error de red. Inténtalo de nuevo.';
			errEl.classList.remove('hidden');
		} finally {
			btn.disabled = false; btn.textContent = 'Enviar magic link';
		}
	});

	// ── Main comment form ────────────────────────────────────────────────────

	const commentContent = document.getElementById('comment-content');
	const charCounter = document.getElementById('char-counter');

	commentContent.addEventListener('input', () => {
		const rem = MAX_CHARS - commentContent.value.length;
		charCounter.textContent = rem;
		charCounter.style.color = rem < 100 ? '#ef4444' : '';
	});

	commentContent.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
			e.preventDefault();
			document.getElementById('comment-form').requestSubmit();
		}
	});

	document.getElementById('comment-form').addEventListener('submit', async (e) => {
		e.preventDefault();
		const content = commentContent.value.trim();
		const btn = e.target.querySelector('button[type="submit"]');
		const errEl = document.getElementById('comment-error');
		btn.disabled = true; btn.textContent = 'Publicando...';
		errEl.classList.add('hidden');
		try {
			const res = await fetch(`${API}/api/comments`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${getJWT()}` },
				body: JSON.stringify({ slug: getSlug(), content }),
			});
			const data = await res.json();
			if (res.status === 401) { clearSession(); showPanel('auth-panel'); return; }
			if (res.ok) {
				appendComment(data);
				commentContent.value = '';
				charCounter.textContent = MAX_CHARS;
				charCounter.style.color = '';
			} else {
				errEl.textContent = data.error ?? 'Error al publicar.';
				errEl.classList.remove('hidden');
			}
		} catch {
			errEl.textContent = 'Error de red.'; errEl.classList.remove('hidden');
		} finally {
			btn.disabled = false; btn.textContent = 'Comentar';
		}
	});

	// ── Reply form ───────────────────────────────────────────────────────────

	const replyContent = document.getElementById('reply-content');
	const replyCounter = document.getElementById('reply-char-counter');

	replyContent.addEventListener('input', () => {
		const rem = MAX_CHARS - replyContent.value.length;
		replyCounter.textContent = rem;
		replyCounter.style.color = rem < 100 ? '#ef4444' : '';
	});

	replyContent.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
			e.preventDefault();
			document.getElementById('reply-submit').click();
		}
	});

	document.getElementById('reply-submit').addEventListener('click', async () => {
		if (!activeReplyId) return;
		const content = replyContent.value.trim();
		if (!content) return;
		const btn = document.getElementById('reply-submit');
		const errEl = document.getElementById('reply-error');
		btn.disabled = true; btn.textContent = 'Enviando...';
		errEl.classList.add('hidden');
		try {
			const res = await fetch(`${API}/api/comments`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${getJWT()}` },
				body: JSON.stringify({ slug: getSlug(), content, parent_id: activeReplyId }),
			});
			const data = await res.json();
			if (res.status === 401) { clearSession(); showPanel('auth-panel'); return; }
			if (res.ok) {
				appendComment(data);
				document.getElementById('reply-form-container').classList.add('hidden');
				activeReplyId = null;
			} else {
				errEl.textContent = data.error ?? 'Error al publicar.';
				errEl.classList.remove('hidden');
			}
		} catch {
			errEl.textContent = 'Error de red.'; errEl.classList.remove('hidden');
		} finally {
			btn.disabled = false; btn.textContent = 'Responder';
		}
	});

	document.getElementById('reply-cancel').addEventListener('click', () => {
		document.getElementById('reply-form-container').classList.add('hidden');
		activeReplyId = null;
	});

	// ── Retry / logout ───────────────────────────────────────────────────────

	document.getElementById('retry-auth-btn')?.addEventListener('click', () => showPanel('auth-panel'));

	document.getElementById('logout-btn').addEventListener('click', () => {
		clearSession();
		showPanel('auth-panel');
		document.getElementById('input-name').value = '';
		document.getElementById('input-email').value = '';
	});

	init();
</script>
