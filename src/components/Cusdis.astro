---
interface Props {
	pageId: string;
	pageUrl: string;
	pageTitle: string;
}

const { pageId, pageUrl, pageTitle } = Astro.props;
---

<div
	id="cusdis_thread"
	class="mt-8"
	data-host="https://cusdis.com"
	data-app-id="845107e6-861d-4404-adda-48385969a286"
	data-page-id={pageId}
	data-page-url={pageUrl}
	data-page-title={pageTitle}
></div>
<script async defer src="https://cdn.jsdelivr.net/npm/@cusdis/sdk/dist/cusdis.umd.js"></script>
